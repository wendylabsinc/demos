FROM dustynv/pytorch:2.7-r36.4.0-cu128-24.04@sha256:4bb7f0a3852f86629ed271aaf6c4aa000305cc4e4673b8e9f334668ee1b22bc8 AS stagefile-pip-deps-0
ENV LD_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu:/usr/lib/aarch64-linux-gnu/nvidia:/usr/lib/aarch64-linux-gnu/tegra:/usr/local/cuda/compat:/usr/local/cuda/lib64"
ENV OMP_NUM_THREADS="1"
ENV OPENBLAS_NUM_THREADS="1"
ENV PATH="/opt/venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV PYTHONDONTWRITEBYTECODE="1"
ENV PYTHONUNBUFFERED="1"
WORKDIR /app
RUN --mount=type=cache,sharing=locked,id=stagefile-apt-lists-e330f35a06a75ecf,target=/var/lib/apt/lists \
    --mount=type=cache,sharing=locked,id=stagefile-apt-archives-e330f35a06a75ecf,target=/var/cache/apt \
    rm -f /etc/apt/apt.conf.d/docker-clean && command -v pip >/dev/null 2>&1 || (apt-get update && apt-get install -y --no-install-recommends 'python3-pip')
RUN --mount=type=cache,sharing=locked,id=stagefile-pip-8eb6417d9c128e6a,target=/root/.cache/pip pip install --root '/opt/stagefile/pip/root' --index-url 'https://pypi.org/simple/' 'numpy==2.2.6' 'opencv-python==4.11.0.86' 'ultralytics==8.4.123'

FROM dustynv/pytorch:2.7-r36.4.0-cu128-24.04@sha256:4bb7f0a3852f86629ed271aaf6c4aa000305cc4e4673b8e9f334668ee1b22bc8 AS dependencies
ENV LD_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu:/usr/lib/aarch64-linux-gnu/nvidia:/usr/lib/aarch64-linux-gnu/tegra:/usr/local/cuda/compat:/usr/local/cuda/lib64"
ENV OMP_NUM_THREADS="1"
ENV OPENBLAS_NUM_THREADS="1"
ENV PATH="/opt/venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV PYTHONDONTWRITEBYTECODE="1"
ENV PYTHONUNBUFFERED="1"
WORKDIR /app
RUN --mount=type=cache,sharing=locked,id=stagefile-apt-lists-e330f35a06a75ecf,target=/var/lib/apt/lists \
    --mount=type=cache,sharing=locked,id=stagefile-apt-archives-e330f35a06a75ecf,target=/var/cache/apt \
    rm -f /etc/apt/apt.conf.d/docker-clean && apt-get update && apt-get install -y --no-install-recommends 'libglib2.0-0' 'libgl1'
COPY --link --from=stagefile-pip-deps-0 /opt/stagefile/pip/root/ /

FROM dependencies AS weights
COPY model/coke-can.pt /models/coke-can.pt

FROM weights AS fixtures
COPY fixtures/ /fixtures/

FROM fixtures AS inference
COPY service.py preprocessing.py postprocessing.py qualification.py /app/
CMD ["python3", "/app/service.py"]
USER 65532
