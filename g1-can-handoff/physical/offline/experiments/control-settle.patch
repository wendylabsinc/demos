+    def wait_for_control_settle(self):
+        """Establish a stable measured hold before creating a pickup reference."""
+        started=time.monotonic();samples=[];last_archive=started
+        self.phase='CONTROL_SETTLING'
+        while time.monotonic()-started<5:
+            if self.cancel.is_set():raise RuntimeError('Operator cancelled control settling')
+            now=time.monotonic();snap=snapshot_guard(self.read(),now=now)
+            body=snap['body']
+            pose=np.r_[body['imu_rpy'],body['q'][:29]]
+            samples.append((now,pose));samples=[s for s in samples if now-s[0]<=.55]
+            if now-last_archive>=.25:self.archive_guard();last_archive=now
+            if samples[-1][0]-samples[0][0]>=.5:
+                span=np.ptp(np.asarray([s[1] for s in samples]),axis=0)
+                if np.all(span[:3]<=.002) and np.all(span[3:18]<=.005) and np.all(span[18:]<=.015):
+                    self.event('control_settled',duration_s=now-started,pose_span_rad=span.tolist())
+                    return
+            time.sleep(.02)
+        raise RuntimeError('Control handover did not settle within 5 seconds')
+
