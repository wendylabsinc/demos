{
  "appId": "DEV-g1-handoff-physical",
  "version": "0.3.30-act-v016",
  "entitlements": [
    {
      "type": "network",
      "mode": "host"
    },
    {
      "type": "persist",
      "name": "g1-handoff-physical",
      "path": "/data"
    }
  ],
  "readiness": {
    "tcpSocket": {
      "port": 8102
    },
    "timeoutSeconds": 60
  },
  "env": {
    "HANDOFF_PLANNER_PROFILE": "tuned",
    "HANDOFF_ARM_KP": "75",
    "HANDOFF_GRIP_STOP_S": "0.2",
    "HANDOFF_GRIP_STOP_SPAN_RAD": "0.005",
    "HANDOFF_GRIP_HOLD_EFFORT_NM": "0.5",
    "HANDOFF_POST_GRASP_CAMERA_CHECKS": "0",
    "HANDOFF_PERCEPTION_POLICY": "continuous",
    "HANDOFF_YOLO_URL": "http://127.0.0.1:8112",
    "HANDOFF_YOLO_MIN_CONFIDENCE": "0.10",
    "HANDOFF_CAMERA_MAX_AGE_MS": "500",
    "HANDOFF_CONTROL_SETTLE_MAX_SPEED_RAD_S": "1",
    "HANDOFF_TABLE_CLEARANCE_M": "0.01",
    "HANDOFF_PLANNING_TABLE_HEIGHT_OFFSET_M": "0.01",
    "HANDOFF_BODY_TEMPERATURE_LIMIT_C": "85",
    "HANDOFF_BODY_CASING_TEMPERATURE_LIMIT_C": "85",
    "HANDOFF_BODY_WINDING_TEMPERATURE_LIMIT_C": "120",
    "HANDOFF_GEOMETRY_WORKERS": "1",
    "HANDOFF_TARGET_IDENTITY": "color_depth",
    "HANDOFF_ACT_POLICY_DIR": "/app/act_policy"
  }
}
