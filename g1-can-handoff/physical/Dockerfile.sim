FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv libegl1 libgl1 libgl1-mesa-dri && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /venv
ENV PATH="/venv/bin:${PATH}" MUJOCO_GL=egl PYOPENGL_PLATFORM=egl
RUN pip install --no-cache-dir mujoco==3.14.0 numpy==2.2.6 scipy==1.15.3 pillow==11.3.0
WORKDIR /work
COPY physical /work/physical
CMD ["python", "-m", "unittest", "discover", "-s", "physical", "-v"]
