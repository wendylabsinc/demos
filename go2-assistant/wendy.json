{
  "appId": "go2-assistant",
  "version": "0.1.0",
  "platform": "linux",
  "language": "python",
  "frameworks": {
    "ros2": {
      "distro": "humble",
      "rmw": "rmw_cyclonedds_cpp",
      "domainId": 0,
      "scope": "peripherals"
    }
  },
  "entitlements": [
    {"type": "network", "mode": "host"},
    {"type": "http", "port": 8787},
    {"type": "persist", "name": "go2-assistant-memory", "path": "/data"}
  ],
  "readiness": {"tcpSocket": {"port": 8787}, "timeoutSeconds": 30}
}
