{
  "appId": "sh.wendy.examples.mesh-ranger",
  "version": "0.4.1",
  "platform": "linux",
  "isolation": "isolated",
  "resources": {
    "memory": "4Gi",
    "pids": 512
  },
  "entitlements": [
    {
      "type": "network",
      "mode": "mesh",
      "serviceCIDR": "10.99.0.0/16",
      "ports": [
        {
          "host": 18090,
          "container": 8090,
          "protocol": "tcp"
        }
      ]
    },
    {
      "type": "gpu"
    },
    {
      "type": "persist",
      "name": "mesh-ranger",
      "path": "/data"
    }
  ],
  "env": {
    "NODE_NAME": "${NODE_NAME}"
  }
}
