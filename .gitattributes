* text=auto
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.lock text eol=lf
*.onnx binary
*.npz binary
*.pt binary
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.glb binary
*.STL binary
*.stl binary

# Keep upstream formatting in vendored browser assets.
**/static/vendor/** -whitespace

# Unified patches preserve a single-space context marker on blank lines.
g1-can-handoff/physical/offline/experiments/*.patch whitespace=-blank-at-eol
